<h1 style="text-align:center; font-size:2rem; font-weight:bold; margin-bottom:20px; color:#333;">
  New Todo Item
</h1>

<div style="max-width:500px; margin:0 auto; padding:20px; border:1px solid #ccc; border-radius:8px; background-color:#f9f9f9;">
  <%= render 'form', todo_item: @todo_item %>
</div>

<div style="text-align:center; margin-top:20px;">
  <%= link_to 'Back to todo items', todo_items_path, style:"display:inline-block; padding:8px 15px; margin:0 5px; text-decoration:none; color:#fff; background-color:#95a5a6; font-weight:bold;  border-radius:5px;" %>
</div>

