<h2 style="text-align:center; margin-bottom:20px;">Log in</h2>

<div style="max-width:400px; margin:0 auto;">
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

    <div style="margin-bottom:15px;">
      <%= f.label :email, style: "display:block; margin-bottom:5px; font-weight:500;" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            style: "width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;" %>
    </div>

    <div style="margin-bottom:15px;">
      <%= f.label :password, style: "display:block; margin-bottom:5px; font-weight:500;" %>
      <%= f.password_field :password,
            autocomplete: "current-password",
            style: "width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div style="margin-bottom:15px; display:flex; align-items:center; gap:6px;">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, style: "margin:0;" %>
      </div>
    <% end %>

    <div style="text-align:center;">
      <%= f.submit "Log in",
            style: "padding:8px 20px; background:#2563eb; color:white; border:none; border-radius:6px; cursor:pointer;" %>
    </div>

  <% end %>

  <div style="margin-top:20px; text-align:center;">
    <%= render "devise/shared/links" %>
  </div>
</div>
